TZ=Europe/Paris
NEXTCLOUD_TAG=apache
NEXTCLOUD_PORT=8090

# Compte créé à la première installation uniquement.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Adresses autorisées, séparées par des espaces.
NEXTCLOUD_TRUSTED_DOMAINS=localhost 192.168.1.10

# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Nombre de jours de dumps quotidiens de la base conservés
DUMP_KEEP_DAYS=7

MARIADB_TAG=11.4
REDIS_TAG=7-alpine
