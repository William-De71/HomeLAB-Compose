TZ=Europe/Paris

# Adresse d'accès (obligatoire derrière un reverse proxy), ex. https://paperless.domaine.fr
PAPERLESS_URL=

# openssl rand -hex 32
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
DB_PASSWORD=changeme

# Langue(s) de l'OCR, ex. fra+eng
PAPERLESS_OCR_LANGUAGE=fra

# Dossier d'import (ex. partage où le scanner dépose ses PDF)
CONSUME_DIR=./data/consume
# Propriétaire des fichiers (id -u / id -g)
PUID=1000
PGID=1000

PAPERLESS_TAG=latest
PAPERLESS_PORT=8000
POSTGRES_TAG=16-alpine
REDIS_TAG=7-alpine
