TZ=Europe/Paris

# Dossier qui contient les services à sauvegarder (monté en /data)
BACKUP_SOURCE=/opt/homelab
# Dépôt local, idéalement sur un autre disque (monté en /repository)
KOPIA_REPOSITORY=./data/repository

# Chiffrement du dépôt : à noter ailleurs, sans lui pas de restauration
KOPIA_PASSWORD=changeme
# Accès à l'interface web
KOPIA_UI_USER=admin
KOPIA_UI_PASSWORD=changeme

KOPIA_HOSTNAME=homelab
KOPIA_TAG=latest
KOPIA_PORT=51515
