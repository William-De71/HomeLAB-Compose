TZ=Europe/Paris

# Adresse à laquelle les applis joignent ntfy
NTFY_BASE_URL=http://192.168.1.10:8097

# deny-all = comptes obligatoires ; read-write = ouvert à tous
NTFY_AUTH_DEFAULT_ACCESS=deny-all
# true derrière un reverse proxy
NTFY_BEHIND_PROXY=false
# Vide pour désactiver le relais iOS
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

NTFY_TAG=latest
NTFY_PORT=8097
