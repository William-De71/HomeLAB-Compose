TZ=Europe/Paris

# Adresse HTTPS par laquelle Vaultwarden est joint (reverse proxy)
DOMAIN=https://vault.domaine.fr

# Passer à false une fois les comptes créés
SIGNUPS_ALLOWED=true
# Page /admin : vide = désactivée. Générer un hash avec :
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# et le coller entre apostrophes simples : ADMIN_TOKEN='$argon2id$...'
ADMIN_TOKEN=

VAULTWARDEN_TAG=latest
VAULTWARDEN_PORT=8222
