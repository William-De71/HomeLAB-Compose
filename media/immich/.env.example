# Lu aussi par Immich lui-même (env_file) : garder ces noms de variables.
TZ=Europe/Paris

# Photos et vidéos : prévoir un disque de grande capacité
UPLOAD_LOCATION=./data/library
# Base de données : disque local (pas de partage réseau)
DB_DATA_LOCATION=./data/db

# Version majeure ou précise (ex. v3.0.0)
IMMICH_VERSION=v3

# Lettres et chiffres uniquement (A-Za-z0-9)
DB_PASSWORD=changeme
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

IMMICH_PORT=2283
