TZ=Europe/Paris

# Dossier contenant films, séries, musique (sous-dossiers par type conseillés)
MEDIA_DIR=/srv/media
# Adresse annoncée aux clients, ex. http://192.168.1.10:8096
JELLYFIN_URL=

# Propriétaire des fichiers de config/cache (id -u / id -g)
PUID=1000
PGID=1000

JELLYFIN_TAG=latest
JELLYFIN_PORT=8096
