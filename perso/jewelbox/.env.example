# Image tag: latest (last release), v1.18.1, v1.18, v1.
JEWELBOX_TAG=latest

# Port sur l'hôte (3001 est pris par Projectory).
JEWELBOX_PORT=3002

# Dossier de musique monté en lecture seule sur /music.
MUSIC_DIR=/chemin/vers/musique

# mDNS discovery (only with network_mode: host, see compose.yaml).
# MDNS_ENABLED=false

# Your own Last.fm application instead of the built-in key.
# LASTFM_API_KEY=
# LASTFM_API_SECRET=

# "Update now" button: uncomment both lines to run Watchtower with JewelBox,
# and pick a secret token (e.g. openssl rand -hex 32).
# COMPOSE_PROFILES=updater
# WATCHTOWER_TOKEN=
